---
// Phosphor icons (regular weight), inlined so they inherit currentColor
const icons = import.meta.glob<string>("/node_modules/@phosphor-icons/core/assets/regular/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  label?: string;
}

const { name, size = 20, label } = Astro.props;
const svg = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!svg) throw new Error(`Unknown icon: ${name}`);
const markup = svg.replace(
  "<svg ",
  `<svg width="${size}" height="${size}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} `,
);
---

<Fragment set:html={markup} />
