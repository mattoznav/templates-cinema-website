---
// Wordmark plus a simple mark: a beam of light opening from a point, like a projector
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<span class="logo">
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <circle cx="6" cy="16" r="3.5" fill="var(--accent)"></circle>
    <path d="M10 13.5 28 5v22L10 18.5z" fill="var(--accent)" opacity="0.35"></path>
    <path d="M10 14.8 28 11v10l-18-3.8z" fill="var(--accent)" opacity="0.7"></path>
  </svg>
  <span class="logo__name">{name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .logo__name {
    font-family: var(--display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
</style>
