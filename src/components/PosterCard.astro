---
import type { Movie } from "../lib/types";
import { releaseDate, runtime } from "../lib/format";

interface Props {
  movie: Movie;
  index?: number;
}
const { movie, index = 0 } = Astro.props;
const meta =
  movie.status === "coming_soon" ? `From ${releaseDate(movie.release_date)}` : [runtime(movie.runtime_minutes), movie.genre_names[0]].filter(Boolean).join("  /  ");
---

<a class="poster-card" href={`/films/${movie.slug}/`} data-reveal style={`--i: ${index % 6}`} data-genres={movie.genres.join(" ")}>
  <span class="poster-card__img">
    <img src={movie.poster} alt="" loading="lazy" width="300" height="450" />
  </span>
  <span class="poster-card__title">{movie.title}</span>
  <span class="poster-card__meta">{meta}</span>
</a>

<style>
  .poster-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 6px;
    text-decoration: none;
  }

  .poster-card__img {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--bg-raised);
    margin-bottom: 8px;
  }

  .poster-card__img img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .poster-card:hover .poster-card__img img {
    transform: scale(1.04);
  }

  .poster-card__title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .poster-card__meta {
    font-size: 13px;
    color: var(--muted);
  }
</style>
