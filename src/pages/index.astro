---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import PosterCard from "../components/PosterCard.astro";
import Programme from "../components/Programme.astro";
import Trailer from "../components/Trailer.astro";
import { catalog } from "../lib/catalog";
import { list, money, releaseDate, runtime } from "../lib/format";

const { venue, movies, halls } = await catalog();
const showing = movies.filter((m) => m.status === "now_showing");
const soon = movies.filter((m) => m.status === "coming_soon");
const [featured] = showing;

// The biggest screen leads the bento
const screens = [...halls].sort((a, b) => b.capacity - a.capacity);
---

<Base>
  {
    featured && (
      <section class="hero">
        <img class="hero__ambient" src={featured.poster} alt="" aria-hidden="true" />
        <div class="wrap hero__grid">
          <div class="hero__text">
            <p class="hero__eyebrow">Now showing</p>
            <h1 class="hero__title">{featured.title}</h1>
            <p class="hero__lead">
              {[runtime(featured.runtime_minutes), featured.genre_names.slice(0, 2).join(", ")]
                .filter(Boolean)
                .join(". ")}
              {featured.directors.length > 0 && `. Directed by ${list(featured.directors)}.`}
            </p>
            <div class="hero__actions">
              <a class="btn btn--primary" href={`/films/${featured.slug}/#showtimes`}>
                <Icon name="ticket" />
                Get tickets
              </a>
              {featured.trailer_youtube_id && (
                <button class="btn btn--ghost" type="button" data-trailer={featured.trailer_youtube_id}>
                  <Icon name="play" />
                  Watch trailer
                </button>
              )}
            </div>
          </div>
          <a class="hero__poster" href={`/films/${featured.slug}/`} tabindex="-1" aria-hidden="true">
            <img src={featured.poster} alt="" width="600" height="900" fetchpriority="high" />
          </a>
        </div>
      </section>
    )
  }

  <section class="section wrap" id="today">
    <div class="section__head">
      <h2 class="section__title">What's on</h2>
      <a class="section__link" href="/programme/">Full programme <Icon name="arrow-right" size={16} /></a>
    </div>
    <Programme movies={movies} mode="day" />
  </section>

  <section class="section rail-section">
    <div class="wrap section__head">
      <h2 class="section__title">In cinemas now</h2>
      <a class="section__link" href="/films/">All films <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="rail">
      {showing.map((m, i) => <PosterCard movie={m} index={i} />)}
    </div>
  </section>

  {
    soon.length > 0 && (
      <section class="section wrap soon">
        <h2 class="section__title">Coming soon</h2>
        <div class="soon__grid">
          {soon.slice(0, 3).map((m, i) => (
            <a class:list={["soon__card", { "soon__card--lead": i === 0 }]} href={`/films/${m.slug}/`} data-reveal style={`--i: ${i}`}>
              <img src={m.poster} alt="" loading="lazy" width="300" height="450" />
              <div class="soon__text">
                <p class="soon__date mono">{releaseDate(m.release_date)}</p>
                <h3 class="soon__title">{m.title}</h3>
                {i === 0 && m.synopsis && <p class="soon__synopsis">{m.synopsis.split(". ").slice(0, 2).join(". ")}.</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="section wrap screens">
    <h2 class="section__title">Four screens, one for every film</h2>
    <div class="screens__grid">
      {
        screens.map((h, i) => (
          <a class:list={["screen", `screen--${i}`]} href="/visit/" data-reveal style={`--i: ${i}`}>
            <span class="screen__format mono">{h.format}</span>
            <span class="screen__name">{h.name}</span>
            <span class="screen__facts">
              {h.capacity} seats. Evening tickets {money(h.base_price, venue.currency)}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <Trailer />
</Base>

<style>
  /* Hero: the featured film, its poster bleeding into the page as ambient light */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 88px) clamp(48px, 7vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .hero__ambient {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    object-fit: cover;
    filter: blur(90px) saturate(140%);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, var(--bg));
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .hero__text {
    animation: rise 0.9s var(--ease) both;
  }

  .hero__eyebrow {
    font-family: var(--mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 18px;
  }

  .hero__title {
    font-size: clamp(44px, 6.4vw, 92px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin-bottom: 22px;
  }

  .hero__lead {
    max-width: 44ch;
    font-size: clamp(17px, 1.4vw, 19px);
    color: var(--ink-soft);
    margin-bottom: 32px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__poster {
    justify-self: end;
    width: min(100%, 380px);
    animation: rise 1.1s 0.1s var(--ease) both;
  }

  .hero__poster img {
    width: 100%;
    border-radius: var(--radius);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(255 255 255 / 0.06);
    transform: rotate(2deg);
    transition: transform 0.6s var(--ease);
  }

  .hero__poster:hover img {
    transform: rotate(0deg) scale(1.01);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  /* Sections */
  .section {
    padding-top: clamp(64px, 8vw, 112px);
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }

  .section__title {
    font-size: clamp(30px, 3.4vw, 48px);
  }

  .section__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 500;
  }

  .section__link:hover {
    color: var(--accent);
  }

  /* Rail: posters scroll sideways */
  .rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(160px, 17vw, 220px);
    gap: 20px;
    overflow-x: auto;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-bottom: 12px;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  }

  .rail > :global(*) {
    scroll-snap-align: start;
  }

  /* Coming soon: one lead card, two smaller ones */
  .soon__grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }

  .soon__card {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 20px;
    align-items: end;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--bg-raised);
    text-decoration: none;
    transition: background-color 0.3s;
  }

  .soon__card:hover {
    background: #1d1d24;
  }

  .soon__card img {
    width: 100%;
    border-radius: 6px;
  }

  .soon__card--lead {
    grid-row: span 2;
    grid-template-columns: minmax(150px, 230px) 1fr;
    gap: 28px;
    padding: 22px;
    background:
      radial-gradient(90% 120% at 100% 100%, rgb(255 207 74 / 0.08), transparent 60%),
      var(--bg-raised);
  }

  .soon__card--lead .soon__text {
    align-self: end;
  }

  .soon__date {
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 8px;
  }

  .soon__title {
    font-size: 22px;
  }

  .soon__card--lead .soon__title {
    font-size: clamp(26px, 2.6vw, 36px);
    margin-bottom: 14px;
  }

  .soon__synopsis {
    color: var(--ink-soft);
    font-size: 15px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Screens bento: the biggest screen leads */
  .screens__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 16px;
    margin-top: 28px;
  }

  .screen {
    display: grid;
    gap: 6px;
    align-content: end;
    min-height: 180px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      transform 0.4s var(--ease),
      border-color 0.3s;
  }

  .screen:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  .screen--0 {
    grid-row: span 2;
    min-height: 380px;
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(255 207 74 / 0.35), transparent 60%),
      linear-gradient(160deg, #23201a, var(--bg-raised) 70%);
  }

  .screen--1 {
    grid-column: span 2;
    background: linear-gradient(120deg, #191b24, #14141a);
  }

  .screen__format {
    font-size: 13px;
    color: var(--accent);
  }

  .screen__name {
    font-family: var(--display);
    font-weight: 650;
    font-size: clamp(24px, 2.4vw, 32px);
    letter-spacing: -0.03em;
  }

  .screen--0 .screen__name {
    font-size: clamp(36px, 4.4vw, 64px);
  }

  .screen__facts {
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 899px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__poster {
      display: none;
    }

    .soon__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .soon__card--lead {
      grid-row: auto;
    }

    .screens__grid {
      grid-template-columns: 1fr 1fr;
    }

    .screen--0,
    .screen--1 {
      grid-column: span 2;
      grid-row: auto;
      min-height: 220px;
    }
  }

  @media (max-width: 559px) {
    .soon__card--lead {
      grid-template-columns: 1fr;
    }

    .screens__grid {
      grid-template-columns: 1fr;
    }

    .screen--0,
    .screen--1 {
      grid-column: auto;
    }
  }
</style>
