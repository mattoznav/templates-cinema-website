---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Programme from "../../components/Programme.astro";
import Trailer from "../../components/Trailer.astro";
import { catalog } from "../../lib/catalog";
import { language, list, releaseDate, runtime } from "../../lib/format";
import type { Movie } from "../../lib/types";

export async function getStaticPaths() {
  const { movies } = await catalog();
  return movies.map((movie) => ({ params: { slug: movie.slug }, props: { movie } }));
}

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;
const { movies } = await catalog();
const showing = movie.status === "now_showing";
const facts = [
  { label: "Running time", value: runtime(movie.runtime_minutes) },
  { label: "Release", value: releaseDate(movie.release_date) },
  { label: "Directed by", value: list(movie.directors) },
  { label: "Starring", value: list(movie.cast) },
  { label: "Language", value: list(movie.languages.map(language)) },
].filter((f) => f.value);
---

<Base title={movie.title} description={movie.synopsis.split(". ")[0]}>
  <section class="film">
    <img class="film__ambient" src={movie.poster} alt="" aria-hidden="true" />
    <div class="wrap film__grid">
      <img class="film__poster" src={movie.poster} alt={`${movie.title} poster`} width="600" height="900" />
      <div class="film__text">
        <p class="film__genres">{movie.genre_names.join(", ")}</p>
        <h1 class="film__title">{movie.title}</h1>
        <div class="film__actions">
          {
            showing ? (
              <a class="btn btn--primary" href="#showtimes">
                <Icon name="ticket" />
                Get tickets
              </a>
            ) : (
              <p class="film__soon mono">In cinemas from {releaseDate(movie.release_date)}</p>
            )
          }
          {
            movie.trailer_youtube_id && (
              <button class="btn btn--ghost" type="button" data-trailer={movie.trailer_youtube_id}>
                <Icon name="play" />
                Watch trailer
              </button>
            )
          }
        </div>
        <dl class="film__facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <div class="wrap film__body">
    {
      showing && (
        <section id="showtimes" class="film__showtimes">
          <h2 class="film__h2">Showtimes</h2>
          <Programme movies={movies} mode="movie" movie={movie.slug} />
        </section>
      )
    }

    {
      movie.synopsis && (
        <section class="film__synopsis">
          <h2 class="film__h2">About the film</h2>
          <p>{movie.synopsis}</p>
          {movie.source_url && (
            <p class="film__credit muted">
              Synopsis from <a href={movie.source_url}>Wikipedia</a>, under{" "}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
            </p>
          )}
        </section>
      )
    }
  </div>

  <Trailer />
</Base>

<style>
  .film {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 80px);
    border-bottom: 1px solid var(--line);
  }

  .film__ambient {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    object-fit: cover;
    filter: blur(90px) saturate(140%);
    opacity: 0.4;
    pointer-events: none;
  }

  .film::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, var(--bg));
    pointer-events: none;
  }

  .film__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(200px, 340px) 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
  }

  .film__poster {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.8);
  }

  .film__genres {
    color: var(--ink-soft);
    margin-bottom: 12px;
  }

  .film__title {
    font-size: clamp(40px, 5.6vw, 80px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 28px;
  }

  .film__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 36px;
  }

  .film__soon {
    color: var(--accent);
  }

  .film__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px 28px;
    margin: 0;
  }

  .film__facts dt {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  .film__facts dd {
    margin: 0;
    color: var(--ink);
  }

  .film__body {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(40px, 6vw, 96px);
    padding-top: clamp(48px, 6vw, 80px);
  }

  .film__body > :only-child {
    grid-column: 1 / -1;
    max-width: 70ch;
  }

  .film__h2 {
    font-size: clamp(26px, 2.6vw, 34px);
    margin-bottom: 24px;
  }

  .film__synopsis p {
    color: var(--ink-soft);
    font-size: 17px;
    max-width: 65ch;
  }

  .film__credit {
    margin-top: 16px;
    font-size: 13px;
  }

  .film__credit a {
    color: inherit;
  }

  @media (max-width: 899px) {
    .film__body {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .film__grid {
      grid-template-columns: 1fr;
    }

    .film__poster {
      width: 52%;
    }
  }
</style>
